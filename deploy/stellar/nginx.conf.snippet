# Place limit_req_zone in nginx's http context, then merge the location blocks
# into the existing server block for www.xclaw.live.
limit_req_zone $binary_remote_addr zone=license_per_ip:10m rate=10r/m;

location = /license {
    return 308 /license/;
}

location = /license/health {
    proxy_pass http://127.0.0.1:18888/health;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location ^~ /license/api/ {
    limit_req zone=license_per_ip burst=20 nodelay;
    client_max_body_size 1m;
    proxy_pass http://127.0.0.1:18888/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;
}

location ^~ /license/ {
    proxy_pass http://127.0.0.1:18080/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
